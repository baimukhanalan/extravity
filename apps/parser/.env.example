# Copy to .env and fill in.

# Base URL of the Next.js app that exposes POST /api/parser/ingest
APP_URL="http://localhost:3000"

# Must equal PARSER_INGEST_SECRET set on the Next.js app / Vercel project
PARSER_INGEST_SECRET="change-me"

# Optional: protect the parser's own POST /run endpoint
PARSER_ADMIN_TOKEN="change-me-too"

# Source-media backend is Vercel Blob by default. `telegram_archive` is a
# temporary canary backend for exact source files up to 20 MiB; its bot must be
# an administrator of a private archive channel and the matching proxy must be
# configured on the site. Use object storage or a Railway volume for scale.
# SOURCE_MEDIA_ROOT must be an absolute path on a persistent volume, separate
# from Telegram's media spool and all account session/state directories.
# MEDIA_STORAGE_BACKEND="railway_volume"
# SOURCE_MEDIA_ROOT="/data/source-media"
# SOURCE_MEDIA_MAX_BYTES=536870912
# TELEGRAM_MEDIA_BOT_TOKEN=""
# TELEGRAM_MEDIA_ARCHIVE_CHAT_ID=""

# Politeness
DEFAULT_RATE_LIMIT_MS=2000
USER_AGENT="Extravity-Parser/1.0 (+https://extracurriculars-kz.vercel.app)"

# --- Telegram collector (MTProto / Telethon) ---
# From https://my.telegram.org → API development tools. These identify the app,
# not the account; the account is authorised once via `python run_telegram.py --login`.
TG_API_ID=""
TG_API_HASH=""

# Stateless hosts (for example Render Free) can keep Telethon auth in a secret
# and channel cursors in the site's database instead of an ephemeral filesystem.
# TG_SESSION_STRING=""
# TG_STATE_URL="https://extracurriculars-kz.vercel.app/api/parser/telegram-state"

# Where Telethon keeps the authorised session and the per-channel read offsets.
# The session file is a credential — it is gitignored, never commit it.
# Production examples for one encrypted persistent volume mounted at /data:
# TG_SESSION_PATH="/data/telegram/eckz"
# TG_STATE_PATH="/data/telegram/state.json"
# TG_LOCK_PATH="/data/telegram/run.lock"

# Politeness knobs (Telegram enforces its own limits via FloodWait on top).
# TG_PAUSE_BETWEEN_CHANNELS_S=3
# TG_MAX_POSTS_PER_CHANNEL=50
# TG_MAX_POST_AGE_DAYS=30
# Short FloodWaits are honoured in-process; longer waits are deferred to a later job.
# TG_MAX_INLINE_FLOOD_WAIT_S=300

# Automatic schedules. Social collectors are deliberately OFF until credentials,
# permissions and a reviewed allowlist exist. Live Telegram requires explicit
# absolute paths on one persistent encrypted volume.
# Enabled collectors run once immediately after a deploy, then on their interval.
# Set false only when an external scheduler deliberately owns the first run.
# PARSER_RUN_ON_STARTUP=true
# WEB_SCHEDULE_ENABLED=true
# WEB_SCHEDULE_INTERVAL_MINUTES=360
# TELEGRAM_LIVE_ENABLED=false
# INSTAGRAM_SCHEDULE_ENABLED=false
# INSTAGRAM_SCHEDULE_INTERVAL_MINUTES=180
# INSTAGRAM_USE_LLM=false
# WHATSAPP_SCHEDULE_ENABLED=false
# WHATSAPP_SCHEDULE_INTERVAL_MINUTES=60

# --- Instagram collector (Graph API) ---
# Issued through Meta for Developers after app review. Needed to read public
# posts by hashtag. Without them, `python run_instagram.py --demo` runs offline.
IG_ACCESS_TOKEN=""
IG_BUSINESS_ID=""
IG_BUSINESS_USERNAME=""
# Used server-side for official /debug_token validation and appsecret_proof.
IG_APP_ID=""
IG_APP_SECRET=""
# Production defaults are fail-closed.
# IG_REQUIRE_TOKEN_INTROSPECTION=true
# Base Graph permissions. When IG_INCLUDE_TAGGED_MEDIA=true, the collector
# additionally requires and verifies instagram_manage_comments.
# IG_REQUIRED_SCOPES="instagram_basic,pages_read_engagement"
# IG_TOKEN_MIN_TTL_DAYS=7
# Optional comma-separated allowlists for Railway onboarding without rebuilding
# the image. YAML and env sources are merged and deduplicated.
# IG_HASHTAGS="олимпиадаkz,хакатонказахстан"
# IG_PROFILES="partner_one,partner_two"
# IG_GRAPH_VERSION="v25.0"
# IG_MAX_MEDIA_PER_HASHTAG=25
# IG_MAX_MEDIA_PER_SOURCE=100
# IG_MAX_PAGES_PER_SOURCE=4
# IG_MAX_MEDIA_BYTES=4194304
# IG_PAUSE_BETWEEN_HASHTAGS_S=2
# IG_INCLUDE_TAGGED_MEDIA=false
# IG_STATE_PATH="/data/instagram-state.json"
# IG_LOCK_PATH="/data/instagram-state.lock"

# --- WhatsApp linked device (unofficial read-only Web client) ---
# Pair locally with `python run_whatsapp.py --pair`. Keep this session on an
# encrypted persistent volume and allowlist exact chat IDs in whatsapp-chats.yaml.
# WA_SESSION_PATH=".session/whatsapp"
# WA_STATE_PATH=".state/whatsapp.json"
# WA_LOCK_PATH=".state/whatsapp.lock"
# WA_BRIDGE_LOCK_PATH=".state/whatsapp-bridge.lock"
# WA_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# WA_BRIDGE_TIMEOUT_S=420
# WA_RECONNECT_TIMEOUT_S=300
# WA_PAIR_TIMEOUT_S=600
# WA_CLEANUP_TIMEOUT_S=30
# WA_PERSIST_SETTLE_MS=5000
# Existing-session probes expire after this many hours for scheduler readiness.
# WA_SESSION_MAX_VERIFICATION_AGE_HOURS=24
# WA_MAX_MESSAGES_PER_CHAT=500
# WA_MAX_MESSAGE_AGE_DAYS=90
# WA_MAX_MEDIA_BYTES=4194304

# --- WhatsApp Cloud API: messages forwarded to the Extravity business number ---
# Callback URL: https://parser-production-51bc.up.railway.app/webhooks/whatsapp
WA_META_APP_SECRET=""
WA_META_VERIFY_TOKEN=""
WA_META_ACCESS_TOKEN=""
# WA_META_GRAPH_VERSION="v25.0"
# WA_META_SOURCE_NAME="WhatsApp Extravity"
# WA_META_SOURCE_URL="https://extracurriculars-kz.vercel.app/contact"

# Optional: LLM pass over post/caption text. Without it the regex baseline still runs.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
