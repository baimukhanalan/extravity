# Copy to .env and fill in real values.

# PostgreSQL connection string (Supabase / Neon / Vercel Postgres / local).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-64-char-hex-string"

# Public app URL (used for absolute links, share, SEO).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Extravity"

# Shared secret for the parser -> app ingest endpoint (same value in apps/parser).
PARSER_INGEST_SECRET="change-me-hex-32"
PARSER_HEALTH_URL="https://parser.example.com/health"
# Comma-separated HTTPS origins manually approved for fail-closed catalog
# auto-publication. The DB feature flag must also be enabled and each item must
# carry explicit media rights evidence; leaving this empty disables the path.
AUTO_PUBLISH_SOURCE_ORIGINS=""
AUTO_PUBLISH_PARSED_TELEGRAM="false"

# Temporary source-media archive. The bot must be an administrator of the
# private archive channel. Both values stay server-side; browsers only receive
# checksum-bound /api/telegram-media URLs. Standard Bot API delivery is capped
# at 20 MiB, so replace this backend with object storage before scale-up.
# TELEGRAM_MEDIA_ARCHIVE_ENABLED="false"
# TELEGRAM_MEDIA_BOT_TOKEN=""
# TELEGRAM_MEDIA_ARCHIVE_CHAT_ID=""

# Auto Apply remains fail-closed until both the API server and worker have a
# verified browser executor deployment. Keep false during connector canaries.
AUTO_APPLY_BROWSER_WORKER_ENABLED="false"

# --- Optional integrations (gracefully mocked until configured) ---
# ANTHROPIC_API_KEY=""         # AI application assistant (else safe template mock)
# CRON_SECRET=""               # Required: protects /api/cron/deadlines (no header-only bypass)

# Email — Resend
# RESEND_API_KEY=""
# EMAIL_FROM="Extravity <noreply@extracurriculars.kz>"

# Telegram bot: /start <code> links a chat, /stop unlinks.
# Register the webhook at https://<domain>/api/telegram/webhook after setting these.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""     # without @, used to build the deep link
# TELEGRAM_WEBHOOK_SECRET=""   # any random string; verified on every update

# Document storage — pick ONE. Bucket must be private; files are served via signed URLs.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""  # server-side only, never expose
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# STORAGE_BUCKET="documents"

# Observability (both are complete no-ops without keys)
# SENTRY_DSN=""
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Payments. Without these the mock provider settles instantly and moves no money.
# PAYMENT_PROVIDER="cloudpayments"   # mock | halyk | kaspi | cloudpayments
# PAYMENT_API_URL=""
# PAYMENT_PUBLIC_ID=""
# PAYMENT_SECRET=""                  # also verifies the webhook HMAC

# Distributed rate limiting (recommended for production). Without it the limiter
# falls back to per-instance in-memory, which does not limit across serverless
# instances. Create a database at upstash.com.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Seed demo accounts (all password123). Defaults to on outside production, off
# in production. Set to "true" only if you deliberately want demo data in prod.
# SEED_DEMO="false"

# Web Push (browser notifications). Generate once: npx web-push generate-vapid-keys
# Mirror the public key into NEXT_PUBLIC_VAPID_PUBLIC_KEY so the browser can subscribe.
# Without these the push toggle is hidden and delivery is a no-op.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@extracurriculars.kz"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Google Gemini (AI-помощник + LLM-слой разбора). Ключ с https://aistudio.google.com/apikey
# Приоритет провайдеров: Gemini → Anthropic → mock.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Kimi (Moonshot AI) — основной AI-провайдер (OpenAI-совместимый API)
# KIMI_API_KEY=sk-...
# KIMI_MODEL=kimi-k2.6
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Groq — основной AI-провайдер (OpenAI-совместимый API, рабочий бесплатный лимит)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Google Search Console verification token (value from the HTML tag method)
GOOGLE_SITE_VERIFICATION=

